{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(img|video|fonts)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "hoehenflug.team-mt.de"
        }
      ],
      "destination": "https://www.hoehenflug.team-mt.de/:path*",
      "permanent": true
    }
  ]
}
